{
  "name": "azores-trip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "weather": "node scripts/fetch-weather.mjs",
    "paths": "node scripts/bake-paths.mjs",
    "dev": "node scripts/validate.mjs && vite",
    "build": "node scripts/validate.mjs && node scripts/fetch-weather.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test": "npm run test:unit && playwright test"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "@fontsource/patrick-hand": "^5.1.0",
    "leaflet": "^1.9.4"
  }
}
